# ------------------------------------------------------------
# Copy this to .env for local runs. On a hosting provider, set
# these as Environment Variables / Secrets instead of uploading .env.
# ------------------------------------------------------------

# REQUIRED: token from @BotFather
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN

# OPTIONAL: your Telegram numeric user id (bot owner)
# OWNER_ID=1223318580

# ------------------------------------------------------------
# FFMPEG - LEAVE ALL OF THIS EMPTY. IT IS AUTOMATIC.
# ------------------------------------------------------------
# ffmpeg ships with the "imageio-ffmpeg" package in requirements.txt,
# so it is installed during the host's pip build step. Nothing is
# downloaded while the bot runs, so the host cannot kill it.
#
# Only set this if you want to force a specific binary. Accepts either
# the folder or the ffmpeg file itself:
#   Windows: FFMPEG_LOCATION=C:\ffmpeg\bin
#   Linux:   FFMPEG_LOCATION=/usr/bin
# FFMPEG_LOCATION=

# Where the auto-resolved binaries are cached. Point at a mounted
# volume if you want the cache to survive redeploys.
# FFMPEG_CACHE_DIR=/data/ffmpeg

# Set to 0 to forbid the last-resort static download completely.
# FFMPEG_ALLOW_DOWNLOAD=1

# ------------------------------------------------------------
# STORAGE (optional)
# ------------------------------------------------------------
# Point these at a mounted volume so they survive restarts.
# DOWNLOAD_DIR=/tmp/downloads
# ADMINS_FILE=/data/admins.json

# ------------------------------------------------------------
# COOKIES (optional, but this is the real fix for Instagram 401)
# ------------------------------------------------------------
# Instagram blocks anonymous requests from datacenter IPs, which is
# what hosting providers give you. Export a cookies.txt from a browser
# where you are logged in (use a throwaway account) and point here.
# COOKIES_FILE=/app/cookies.txt
